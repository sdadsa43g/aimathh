# AIMathH environment configuration — copy to .env and edit
AIMATHH_ENV=dev
AIMATHH_DATA_DIR=./data
AIMATHH_ARTIFACT_DIR=./data/artifacts
AIMATHH_DB_PATH=./data/aimathh.db
AIMATHH_LOG_LEVEL=INFO

# Model providers (all optional; harness works with MockProvider + local compute)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=

# Execution sandbox
AIMATHH_SANDBOX_ROOT=./data/sandbox
AIMATHH_DEFAULT_TIMEOUT_S=120
AIMATHH_MAX_MEMORY_MB=2048
AIMATHH_ALLOW_NETWORK=false
AIMATHH_ALLOW_INSTALL=false

# API server
AIMATHH_API_HOST=0.0.0.0
AIMATHH_API_PORT=8000
AIMATHH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
